# ─────────────────────────────────────────────────────────────────────────────
# Heal Hope – Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (PostgreSQL for production)
# Leave empty to fall back to SQLite (dev only)
DATABASE_URL=postgresql://user:password@localhost:5432/healhope_db

# CORS – comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Redis (WebSocket channel layer + caching)
REDIS_URL=redis://localhost:6379/0

# AI Keys
GOOGLE_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your_openai_api_key_here

# Mem0
MEM0_API_KEY=your_mem0_api_key_here

# Vector Database
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./vector_db

# AI Model defaults
DEFAULT_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# Email (for password reset & notifications)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Debug flags
DEBUG_AI=False
